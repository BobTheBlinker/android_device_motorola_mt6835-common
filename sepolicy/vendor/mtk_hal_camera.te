r_dir_file(mtk_hal_camera, sysfs_therm)

# Denied on stock too; the camera works without them.
dontaudit mtk_hal_camera { config_prop default_prop }:file r_file_perms;
dontaudit mtk_hal_camera vendor_default_prop:property_service set;
dontaudit mtk_hal_camera { graphics_config_prop graphics_config_writable_prop }:file r_file_perms;
dontaudit mtk_hal_camera system_data_file:dir search;
