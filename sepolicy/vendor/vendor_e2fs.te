type vendor_e2fs, domain;
type vendor_e2fs_exec, exec_type, vendor_file_type, file_type;

allow vendor_e2fs self:capability kill;
allow vendor_e2fs dynamicdata:fd use;
allow vendor_e2fs dynamicdata:process sigchld;

allow vendor_e2fs block_device:dir search;
allow vendor_e2fs cache_block_device:blk_file getattr;
allow vendor_e2fs dm_device:blk_file rw_file_perms;
allow vendor_e2fs dm_device:chr_file rw_file_perms;
allow vendor_e2fs userdata_block_device:blk_file rw_file_perms;
allowxperm vendor_e2fs { dm_device userdata_block_device }:blk_file ioctl { BLKROGET BLKDISCARD BLKPBSZGET BLKDISCARDZEROES BLKSECDISCARD };

allow vendor_e2fs devpts:chr_file { getattr ioctl read write };
allow vendor_e2fs kmsg_device:chr_file w_file_perms;
allow vendor_e2fs proc_swaps:file r_file_perms;
r_dir_file(vendor_e2fs, sysfs_fs_ext4_features)
allow vendor_e2fs vendor_file:file read;
