type vendor_make_f2fs, domain;
type vendor_make_f2fs_exec, exec_type, vendor_file_type, file_type;

allow vendor_make_f2fs self:capability kill;
allow vendor_make_f2fs dynamicdata:fd use;
allow vendor_make_f2fs dynamicdata:process sigchld;

allow vendor_make_f2fs block_device:dir search;
allow vendor_make_f2fs cache_block_device:blk_file getattr;
allow vendor_make_f2fs dm_device:blk_file rw_file_perms;
allow vendor_make_f2fs dm_device:chr_file rw_file_perms;
allow vendor_make_f2fs userdata_block_device:blk_file rw_file_perms;
allowxperm vendor_make_f2fs { dm_device userdata_block_device }:blk_file ioctl { BLKROGET BLKDISCARD BLKPBSZGET BLKDISCARDZEROES BLKSECDISCARD };

allow vendor_make_f2fs devpts:chr_file { getattr ioctl read write };
allow vendor_make_f2fs kmsg_device:chr_file w_file_perms;
allow vendor_make_f2fs proc_swaps:file r_file_perms;
r_dir_file(vendor_make_f2fs, sysfs_fs_ext4_features)
allow vendor_make_f2fs vendor_file:file read;
